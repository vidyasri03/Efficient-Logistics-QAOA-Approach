# Environment Configuration Example
# Copy this file to .env and update with your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# QAOA Default Parameters
QAOA_DEFAULT_REPS=1
QAOA_DEFAULT_SHOTS=1024
QAOA_MAX_ITER=100

# Solver Timeouts (seconds)
CLASSICAL_SOLVER_TIMEOUT=30
QUANTUM_SOLVER_TIMEOUT=300

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10
MAX_NODES=20

# Logging
LOG_LEVEL=INFO

# Frontend
FRONTEND_PORT=8501
BACKEND_URL=http://localhost:8000
